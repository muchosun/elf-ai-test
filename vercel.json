{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "git": {
    "deploymentEnabled": {
      "codex/vercel-migration": true
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/:authpath*",
      "destination": "/api/auth?authpath=:authpath*"
    }
  ]
}
