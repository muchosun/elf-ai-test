# Set in Vercel Environment Variables. Never put secrets in VITE_* variables.
AUTH_URL=https://elf.pink
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_APPLE_ID=
# Apple signed client-secret JWT, renewed before expiry; keep .p8 key outside repo.
AUTH_APPLE_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
# Checkout settings are listed in services/mavs-checkout/.env.example.

# TrackWill goal names must match offer 47749 / campaign 134282; no default guessing.
TRACKWILL_ENABLED=false
TRACKWILL_REGISTRATION_TYPE=reg
TRACKWILL_TEST_ORDER_TYPE=elf_test_order
# Set only for a dedicated non-paid test-order goal; sale is rejected for simulation.
TRACKWILL_TEST_GOAL_CONFIRMED=false
